# ============================================================
# AdaptiveAI — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# ----- Application -----
APP_NAME="AdaptiveAI"
APP_VERSION="0.1.0"
APP_ENV="development"          # development | staging | production
DEBUG=true
SECRET_KEY="CHANGE_ME_use_openssl_rand_hex_32"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ----- Database -----
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="adaptiveai"
POSTGRES_USER="adaptiveai_user"
POSTGRES_PASSWORD="CHANGE_ME"
# Constructed automatically: postgresql+asyncpg://user:pass@host:port/db
# DATABASE_URL=postgresql+asyncpg://adaptiveai_user:CHANGE_ME@localhost:5432/adaptiveai

# ----- JWT -----
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ----- AI Provider -----
# Options: openai | gemini | anthropic | local
AI_PROVIDER="openai"
EMBEDDING_PROVIDER="openai"     # Can differ from LLM provider

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_LLM_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS=1536

# Google Gemini
GEMINI_API_KEY=""
GEMINI_LLM_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"
GEMINI_EMBEDDING_DIMENSIONS=768

# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_LLM_MODEL="claude-3-5-haiku-20241022"

# ----- RAG / Retrieval -----
RAG_TOP_K=10                    # Chunks retrieved before reranking
RAG_TOP_K_RERANKED=5            # Chunks sent to LLM after reranking
RAG_SIMILARITY_THRESHOLD=0.70   # Minimum cosine similarity to include chunk
MAX_CONTEXT_TOKENS=8000         # Max tokens for retrieved context

# ----- Confidence Thresholds (Section 16) -----
CONFIDENCE_HIGH_THRESHOLD=0.80
CONFIDENCE_LOW_THRESHOLD=0.50

# ----- Document Processing -----
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES="pdf,docx,txt,csv,md"
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
STORAGE_PATH="./storage/documents"

# ----- Rate Limiting -----
RATE_LIMIT_PER_MINUTE=60

# ----- Super Admin (seeded on first run) -----
SUPER_ADMIN_EMAIL="superadmin@adaptiveai.dev"
SUPER_ADMIN_PASSWORD="CHANGE_ME_strong_password"
